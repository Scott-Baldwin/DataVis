   "source": [
    "import os\n",
    "import polars as pl\n",
    "\n",
    "file_path = os.path.join(\n",
    "    os.path.dirname(os.getcwd()),\n",
    "    \"src\",\n",
    "    \"data\",\n",
    "    \"nyc-tmy-2023.csv\",\n",
    ")\n",
    "\n",
    "df = pl.read_csv(file_path, skip_rows=2)\n",
    "df.group_by([\"Year\", \"Month\", \"Day\"], maintain_order=True).agg(\n",
    "    pl.col(\"Temperature\").max()\n",
    ")"
   ]
  }
